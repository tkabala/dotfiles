[user]
	email = tomasz.kabala@gmail.com
	name = Tomasz Kabala

[init]
	defaultBranch = main

[fetch]
	prune = true

[push]
	autoSetupRemote = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
