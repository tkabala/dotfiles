[user]
	email = {{ .email }}
	name = Tomasz Kabala

[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	rebase = true            # replay local commits on top of upstream instead of a merge commit

[push]
	autoSetupRemote = true

[merge]
	conflictstyle = zdiff3

[rerere]
	enabled = true           # remember how conflicts were resolved...
	autoupdate = true        # ...and stage the reused resolution

[diff]
	algorithm = histogram    # clearer diffs when code is moved or edited
	colorMoved = default
	mnemonicPrefix = true    # i/ w/ c/ instead of a/ b/ in diff headers

[commit]
	verbose = true           # show the diff in the commit message editor

[column]
	ui = auto                # list branches, tags etc. in columns

[branch]
	sort = -committerdate    # most recently used branches first

[tag]
	sort = -version:refname  # v1.10 after v1.9

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true

# gh comes from mise (~/.config/mise/config.toml), on every machine.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Machine-local settings (credential helpers, etc.); untracked, skipped if missing.
# Keep last so it overrides everything above.
[include]
	path = ~/.gitconfig.local
