[user]
	email = {{ .email }}
	name = Tomasz Kabala

[init]
	defaultBranch = main

[fetch]
	prune = true

[push]
	autoSetupRemote = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
{{- if lookPath "gh" }}

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
{{- end }}
