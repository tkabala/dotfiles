#!/bin/bash
# Install base packages needed by these dotfiles, install Homebrew and the packages
# it manages, and make zsh the login shell.
# Runs before dotfiles are applied, and again whenever this script or the package
# lists in .chezmoidata/packages.toml change (the lists are rendered in below).
set -euo pipefail

{{- $packages := .packages.common }}
{{- $homebrew := .homebrew.common }}
{{- if .work }}{{ $homebrew = concat $homebrew .homebrew.work }}{{ end }}
SUDO=""
[ "$(id -u)" -ne 0 ] && SUDO="sudo"

# Install Homebrew if it's missing, and put it on PATH for the rest of this script.
# Its installer refuses to run as root on Linux (outside containers), so skip it there.
enable_homebrew() {
  local brew
  for brew in "$(command -v brew || true)" /opt/homebrew/bin/brew /usr/local/bin/brew \
      /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
    [ -x "$brew" ] && eval "$("$brew" shellenv)" && return 0
  done
{{- if ne .chezmoi.os "darwin" }}
  if [ "$(id -u)" -eq 0 ]; then
    echo "Homebrew won't install as root; skipping it{{ if $homebrew }} and its packages ({{ $homebrew | join " " }}){{ end }}" >&2
    return 1
  fi
{{- end }}
  # Refresh sudo first: the installer runs non-interactively and only uses sudo -n.
  sudo -v
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  for brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    [ -x "$brew" ] && eval "$("$brew" shellenv)" && return 0
  done
  echo "Homebrew installed, but no brew found" >&2
  return 1
}

{{ if eq .chezmoi.os "darwin" -}}
enable_homebrew
brew install {{ concat $packages .packages.brew $homebrew | join " " }}
{{ else if eq .chezmoi.os "linux" -}}
{{   if or (eq .chezmoi.osRelease.id "debian" "ubuntu") (contains "debian" (get .chezmoi.osRelease "idLike")) -}}
$SUDO apt-get update
$SUDO apt-get install -y {{ concat $packages .packages.apt | join " " }}
# command-not-found's database is built by an apt update hook it installs,
# so update again now that the hook is there.
$SUDO apt-get update
{{   else if or (eq .chezmoi.osRelease.id "arch") (contains "arch" (get .chezmoi.osRelease "idLike")) -}}
$SUDO pacman -Sy --needed --noconfirm {{ concat $packages .packages.pacman | join " " }}
# pkgfile (command-not-found): build its file database once, then keep it fresh daily.
[ -n "$(ls -A /var/cache/pkgfile 2>/dev/null)" ] || $SUDO pkgfile -u
$SUDO systemctl enable --now pkgfile-update.timer || echo "couldn't enable pkgfile-update.timer; run: sudo pkgfile -u now and then" >&2
{{   else if eq .chezmoi.osRelease.id "fedora" -}}
$SUDO dnf install -y {{ concat $packages .packages.dnf | join " " }}
{{   else -}}
echo "Unsupported distro '{{ .chezmoi.osRelease.id }}'; install manually: {{ $packages | join " " }}" >&2
{{   end }}
# Homebrew after the distro packages: it needs their curl, git and compiler.
{{   if $homebrew -}}
if enable_homebrew; then
  brew install {{ $homebrew | join " " }}
fi
{{   else -}}
enable_homebrew || true
{{   end -}}
{{ end }}

# Make zsh the default login shell. Check the account's shell, not $SHELL:
# that's whatever shell ran chezmoi (bash under Claude Code, for one).
{{ if eq .chezmoi.os "darwin" -}}
LOGIN_SHELL="$(dscl . -read "/Users/$(id -un)" UserShell | awk '{print $2}')"
{{ else -}}
LOGIN_SHELL="$(getent passwd "$(id -un)" | cut -d: -f7)"
{{ end -}}
ZSH_PATH="$(command -v zsh || true)"
if [ -n "$ZSH_PATH" ] && [ "$(basename "${LOGIN_SHELL:-}")" != "zsh" ]; then
  grep -qx "$ZSH_PATH" /etc/shells || echo "$ZSH_PATH" | $SUDO tee -a /etc/shells >/dev/null
  # via sudo so chsh doesn't prompt for the user's password (no tty during apply)
  $SUDO chsh -s "$ZSH_PATH" "$(id -un)" || echo "chsh failed; run: chsh -s $ZSH_PATH" >&2
fi
