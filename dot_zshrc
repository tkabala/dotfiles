export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Oh My Zsh: completion, history and key bindings, plus the plugins below.
# No theme: the prompt is starship (~/.config/zsh/20-tools.zsh).
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""

# zsh-autosuggestions and zsh-syntax-highlighting come from .chezmoiexternal;
# zsh-syntax-highlighting has to stay last.
plugins=(git python zsh-autosuggestions zsh-syntax-highlighting)

# python plugin: auto-activate .venv / venv on cd
PYTHON_VENV_NAME=".venv"
PYTHON_VENV_NAMES=($PYTHON_VENV_NAME venv)
PYTHON_AUTO_VRUN=true

source $ZSH/oh-my-zsh.sh

# Personal env, tools, aliases and functions: ~/.config/zsh/*.zsh, in name order
for zsh_conf in ~/.config/zsh/*.zsh(N); do source "$zsh_conf"; done
unset zsh_conf

# eza instead of ls
if (( $+commands[eza] )); then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

# herdr: update (at most daily), then autostart. Updating has to happen here,
# before launch, because herdr can't self-update from inside a session.
# Skipped inside herdr, in IDE terminals, and with HERDR_NO_AUTOSTART=1.
if [[ -o interactive && -z "$HERDR_ENV" && -z "$HERDR_NO_AUTOSTART" \
      && "$TERM_PROGRAM" != vscode && "$TERMINAL_EMULATOR" != JetBrains-JediTerm ]] \
    && (( $+commands[herdr] )); then
  herdr-update-check
  herdr
fi
