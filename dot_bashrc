# bash is Claude Code's shell (env.CLAUDE_CODE_SHELL in ~/.claude/settings.json);
# interactive shells are zsh. So this stays small: Claude's shell inherits PATH and
# the rest of the environment from the terminal it was started in.

# This machine's own additions (env vars, tool setup), not tracked in the repo.
[[ -r ~/.bashrc.local ]] && . ~/.bashrc.local

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH=$HOME/.local/bin:$PATH ;;
esac

# mise. Claude Code's shell never shows a prompt, so mise's prompt hook never runs
# and a project's mise.toml would be ignored. Under Claude Code (CLAUDECODE is set),
# drop the global tool dirs inherited from the terminal and use shims instead, which
# pick the version per directory each time a tool runs.
if command -v mise >/dev/null; then
  if [[ -n $CLAUDECODE ]]; then
    PATH=$(tr ':' '\n' <<<"$PATH" | grep -v "^${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/installs/" | paste -sd:)
    eval "$(mise activate bash --shims)"
  elif [[ $- == *i* ]]; then
    eval "$(mise activate bash)"
  fi
fi
