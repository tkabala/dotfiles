{{- /* Per-machine settings: asked on first `chezmoi init`, stored in ~/.config/chezmoi/chezmoi.toml. */ -}}
{{- $work := promptBoolOnce . "work" "Is this a work machine" -}}
{{- $email := "" -}}
{{- if $work -}}
{{-   $email = promptStringOnce . "email" "Git email" -}}
{{- else -}}
{{-   $email = promptStringOnce . "email" "Git email" "tomasz.kabala@gmail.com" -}}
{{- end -}}

[data]
  work = {{ $work }}
  email = {{ $email | quote }}

# `chezmoi merge`: three-way merge in nvim's diff mode (chezmoi adds the
# destination, source and target files after these args).
[merge]
  command = "nvim"
  args = ["-d"]
