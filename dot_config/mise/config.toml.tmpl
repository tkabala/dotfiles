[tools]
bun = "latest"
claude = "latest"
gh = "latest"
go = "1.26.8"
lazydocker = "latest"
lazygit = "latest"
node = "24"
pi = "latest"
pnpm = "12"
shellcheck = "latest"
uv = "latest"
{{- if eq (includeTemplate "is-apt" .) "true" }}

# Debian/Ubuntu: their neovim is too old for LazyVim and they don't package
# starship. Elsewhere both come from pacman / brew (.chezmoidata/packages.toml).
neovim = "latest"
starship = "latest"
{{- end }}
{{- if .work }}

# Work machines
java = "corretto-21"
maven = "3.9"
kubectl = "latest"
helm = "latest"
aws-cli = "latest"
# govc isn't in mise's registry: it ships in the govmomi releases.
"aqua:vmware/govmomi/govc" = "latest"
glab = "latest"
vault = "latest"
# playwright-cli, for the Claude Code skill of the same name
"npm:@playwright/cli" = "latest"
{{- end }}

[settings.upgrade]
auto_prune = false
