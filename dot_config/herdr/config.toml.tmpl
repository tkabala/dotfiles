onboarding = false

[terminal]
# New panes and tabs open in the current pane's directory
new_cwd = "follow"

[ui]
# Switch to the mobile layout in terminals narrower than 100 columns
mobile_width_threshold = 100

# Close tabs and workspaces without asking
confirm_close = false
{{- /* Machine-local additions: appended from config.local.toml (untracked) if it exists. */}}
{{- $local := joinPath .chezmoi.homeDir ".config/herdr/config.local.toml" }}
{{- if stat $local }}

{{ include $local | trimSuffix "\n" }}
{{- end }}
