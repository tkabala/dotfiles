#!/bin/sh
# chezmoi modify script: gets the current ~/.claude/settings.json on stdin and
# prints the new one. Only statusLine, env.CLAUDE_CODE_SHELL and
# env.DISABLE_AUTOUPDATER are managed here; everything else (hooks, plugins,
# /config changes) is left to Claude Code.
# CLAUDE_CODE_SHELL: run Claude's commands in bash rather than the login shell
# (zsh), since the commands it writes assume bash semantics.
# DISABLE_AUTOUPDATER: mise installs and updates Claude Code (`mise up claude`); the
# built-in updater would put a second copy back in ~/.local/bin.
current=$(cat)
[ -n "$current" ] || current='{}'
# Without jq, or if the file isn't valid JSON, leave it as it is.
printf '%s\n' "$current" | jq --indent 2 '.statusLine = {
  "type": "command",
  "command": "~/.claude/statusline.sh",
  "padding": 0,
  "refreshInterval": 10
} | .env.CLAUDE_CODE_SHELL = "/bin/bash" | .env.DISABLE_AUTOUPDATER = "1"' 2>/dev/null || printf '%s\n' "$current"
