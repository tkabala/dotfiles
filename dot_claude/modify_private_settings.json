#!/bin/sh
# chezmoi modify script: gets the current ~/.claude/settings.json on stdin and
# prints the new one. Only statusLine, theme, showTurnDuration,
# awaySummaryEnabled, idleCompaction,
# env.CLAUDE_CODE_SHELL, env.DISABLE_AUTOUPDATER and env.CLAUDE_CODE_PLUGIN_DIRS are managed here; everything else (hooks, plugins,
# /config changes) is left to Claude Code.
# theme: the Tokyo Night theme in ~/.claude/themes/tokyo-night.json.
# subagentStatusLine: removed from older setups; Claude Code dropped the setting.
# awaySummaryEnabled: off, so no session recap when returning after 5+ minutes away.
# idleCompaction: off, so a long conversation isn't compacted while the session sits idle.
# showTurnDuration: the "Cooked for 1m 6s" line after each response (on by default;
# set here so every machine shows it).
# CLAUDE_CODE_SHELL: run Claude's commands in bash rather than the login shell
# (zsh), since the commands it writes assume bash semantics.
# DISABLE_AUTOUPDATER: mise installs and updates Claude Code (`mise up claude`); the
# built-in updater would put a second copy back in ~/.local/bin.
# CLAUDE_CODE_PLUGIN_DIRS: the mods in ~/.claude/mods (usage-planner, cache-keepalive), loaded in every session
# (colon-separated; add a folder here for each new mod).
current=$(cat)
[ -n "$current" ] || current='{}'
# Without jq, or if the file isn't valid JSON, leave it as it is.
printf '%s\n' "$current" | jq --indent 2 '.statusLine = {
  "type": "command",
  "command": "~/.claude/statusline.sh",
  "padding": 0,
  "refreshInterval": 10
} | del(.subagentStatusLine) | .theme = "custom:tokyo-night" | .showTurnDuration = true | .awaySummaryEnabled = false | .idleCompaction = false | .env.CLAUDE_CODE_SHELL = "/bin/bash" | .env.DISABLE_AUTOUPDATER = "1" | .env.CLAUDE_CODE_PLUGIN_DIRS = "~/.claude/mods/usage-planner:~/.claude/mods/cache-keepalive"' 2>/dev/null || printf '%s\n' "$current"
