# External sources pulled by chezmoi on apply.
# git-repo keeps ~/.oh-my-zsh a real clone, so oh-my-zsh's own updater keeps working;
# chezmoi also runs `git pull` at most once per refreshPeriod (or with `chezmoi apply -R`).

[".oh-my-zsh"]
    type = "git-repo"
    url = "https://github.com/ohmyzsh/ohmyzsh.git"
    refreshPeriod = "168h"
    [".oh-my-zsh".clone]
        args = ["--depth", "1"]
    [".oh-my-zsh".pull]
        args = ["--ff-only"]

# herdr: installed here only when missing (see .chezmoiignore). After that herdr
# owns the binary and ~/.local/bin/herdr-update-check keeps it current, using
# `herdr update --handoff` so running sessions move to the new version.
{{- $os := .chezmoi.os | replace "darwin" "macos" }}
{{- $arch := .chezmoi.arch | replace "amd64" "x86_64" | replace "arm64" "aarch64" }}
[".local/bin/herdr"]
    type = "file"
    url = "https://github.com/herdrdev/herdr/releases/latest/download/herdr-{{ $os }}-{{ $arch }}"
    executable = true

# delta (git pager): not in Debian bookworm's apt, so on Linux pull the release
# binary. Pinned because release asset names include the version; bump to update.
# macOS gets it from Homebrew (.chezmoidata/packages.toml).
{{- if eq .chezmoi.os "linux" }}
{{-   $deltaVersion := "0.19.2" }}
{{-   $deltaTarget := "x86_64-unknown-linux-musl" }}
{{-   if eq .chezmoi.arch "arm64" }}{{ $deltaTarget = "aarch64-unknown-linux-gnu" }}{{ end }}
[".local/bin/delta"]
    type = "archive-file"
    url = "https://github.com/dandavison/delta/releases/download/{{ $deltaVersion }}/delta-{{ $deltaVersion }}-{{ $deltaTarget }}.tar.gz"
    path = "delta"
    stripComponents = 1
    executable = true
{{- end }}
